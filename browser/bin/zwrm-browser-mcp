#!/bin/sh
# Launches the `browser` MCP server (Playwright MCP) on the persistent
# profile, after clearing a stale Chromium profile lock.
#
# Chromium leaves Singleton{Lock,Socket,Cookie} in the profile while it runs.
# The profile lives on the workspace volume, so a VM killed mid-browse (host
# crash, forced stop, a cold-boot migration) leaves them behind. Playwright
# MCP then treats the profile as in use whenever ANY live process has the pid
# recorded in the lock, and every browser call fails until that pid frees up.
# Nothing can be using the profile unless a Chrome process was started on it,
# so with none running the lock is stale by definition.
PROFILE=/home/agent/.zwrm/browser/profile

if ! pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null 2>&1; then
    rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonSocket" "$PROFILE/SingletonCookie"
fi

# The browser runs HEADED on the virtual desktop, so the dashboard's live view
# shows what the agent is browsing and a member who takes control drives the
# same browser (zwrm-eu/zwrm#1680). Headed Chromium needs the display, so
# start it first (a no-op when it already runs). If it cannot start, browse
# headless rather than not at all.
MODE=--headless
if /usr/local/bin/node /opt/zwrm-computer-mcp/desktop.mjs start >/dev/null 2>&1; then
    MODE=
    export DISPLAY=:99
else
    # stderr reaches the daemon/harness log: a black live view is diagnosable.
    echo "zwrm-browser-mcp: the desktop did not start; browsing headless (not visible in the live view)" >&2
fi

exec /usr/local/bin/playwright-mcp --user-data-dir "$PROFILE" $MODE "$@"
