#!/usr/local/bin/node
// Turns BROWSER_PROXY (an agent secret) into a Playwright MCP config file and
// prints its path, for zwrm-browser-mcp.
//
// BROWSER_PROXY is a URL: http://host:port, https://host:port or
// socks5://host:port, with optional credentials (http://user:pass@host:port).
// Playwright MCP's --proxy-server flag carries only the server, so the
// credentials go into the config file's browser.launchOptions.proxy instead.
// The file is written mode 600 to /tmp, which init wipes on every boot.
//
// A value that cannot be used is an error, not a silent fallback: the person
// set a proxy so the browser would not use the VM's own address.
import { writeFileSync } from 'node:fs'

const fail = (msg) => {
  process.stderr.write(`zwrm-browser-mcp: BROWSER_PROXY ${msg}\n`)
  process.exit(1)
}

let url
try {
  url = new URL(process.env.BROWSER_PROXY || '')
} catch {
  fail('is not a URL (want http://[user:pass@]host:port)')
}
const scheme = url.protocol.replace(/:$/, '')
if (!['http', 'https', 'socks5'].includes(scheme)) fail(`has unsupported scheme "${scheme}" (http, https or socks5)`)
if (!url.hostname || !url.port) fail('needs a host and a port')
const username = decodeURIComponent(url.username)
const password = decodeURIComponent(url.password)
// Chromium cannot authenticate to a SOCKS5 proxy.
if (scheme === 'socks5' && (username || password)) fail('socks5 with credentials is not supported by Chromium; use an http proxy')

const proxy = { server: `${scheme}://${url.hostname}:${url.port}`, bypass: 'localhost,127.0.0.1' }
if (username) proxy.username = username
if (password) proxy.password = password

const path = '/tmp/.zwrm-browser-proxy.json'
writeFileSync(path, JSON.stringify({ browser: { launchOptions: { proxy } } }), { mode: 0o600 })
process.stdout.write(path)
