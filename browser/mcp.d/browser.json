{
  "command": "/usr/local/bin/zwrm-browser-mcp",
  "args": [
    "--browser",
    "chromium",
    "--no-sandbox",
    "--viewport-size",
    "1280x720",
    "--output-dir",
    "/home/agent/.zwrm/browser/output",
    "--output-max-size",
    "104857600"
  ],
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "/opt/ms-playwright"
  }
}
